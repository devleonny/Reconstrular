#!/bin/sh
# Atualiza o ?v= dos css/js no index.html com o hash do conteúdo que vai no commit,
# a versão do site (versao.json, aviso de nova versão) e o cache do PWA (sw.js).
# Ativar uma vez por clone:  git config core.hooksPath .githooks
node scripts/versionar.js --staged || {
    echo "versionar: falhou; commit cancelado. Rode 'node scripts/versionar.js' para ver o erro."
    exit 1
}
